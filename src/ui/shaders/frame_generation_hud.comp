#version 450
// Frame generation: interpolation warps the whole image, HUD included. Put the
// real frame's HUD back over the generated frame wherever the producer's
// reactive mask marks HUD pixels (render resolution, sampled bilinearly).
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgb10_a2) uniform image2D generated;
layout(set = 0, binding = 1) uniform texture2D real_frame;
layout(set = 0, binding = 2) uniform texture2D hud_mask;
layout(set = 0, binding = 3) uniform sampler linear_sampler;
layout(push_constant) uniform Constants { uvec2 size; } pc;

void main() {
  const uvec2 pixel = gl_GlobalInvocationID.xy;
  if (any(greaterThanEqual(pixel, pc.size))) return;
  const vec2 uv = (vec2(pixel) + 0.5) / vec2(pc.size);
  // Widen the soft edge of the upsampled mask so HUD outlines are covered.
  const float hud = clamp(textureLod(sampler2D(hud_mask, linear_sampler), uv, 0.0).r * 2.0, 0.0, 1.0);
  if (hud <= 0.0) return;
  const vec4 real = texelFetch(sampler2D(real_frame, linear_sampler), ivec2(pixel), 0);
  imageStore(generated, ivec2(pixel), mix(imageLoad(generated, ivec2(pixel)), real, hud));
}
